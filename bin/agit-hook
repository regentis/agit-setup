#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Record the edits of a coding agent with git stamp, from the agent's
# hooks:
#
#   agit-hook <agent> <event>   < hook input (JSON)
#
# <agent> names the agent whose hook input is read: "claude" (Claude
# Code), "codex" (Codex CLI), "cursor" (Cursor) or "gemini" (Gemini
# CLI).  Each agent has a function input_<agent> that maps its input to
# the variables tool, sid, cwd, path, cmd, transcript and model, and,
# for the agents that take a session context, context_<agent>, which
# prints it in their form; model_<agent>, for agents whose transcript
# format is documented, reads the model from it.
#
# Events:
#
#   session-start  remember the model, print the context for the agent
#   session-end    forget the session
#   pre-edit       git stamp begin -- <file>, before the agent writes it
#   post-edit      git stamp end -- <file>, after it did
#   pre-shell      git stamp begin, whole tree, before a shell command
#   post-shell     git stamp end, whole tree, after it
#
# The reasoning of a commit is the agent's own: the context asks it to
# record it with git stamp reason, and git commit warns when it did
# not.  The pre-commit event of earlier versions, which wrote one from
# the transcript, does nothing: the hooks of an older plugin may still
# run it.
#
# The script never fails and never blocks the agent: it exits 0, prints
# nothing but the session context, and logs its errors to
# $AGIT_HOME/log/hook.log.  It does nothing unless the git it runs is
# agit, the path is inside a worktree, and provenance.enabled is not
# false there.  That git is $AGIT_GIT if set, else the one installed in
# $AGIT_HOME (install.sh), else git on PATH: an agent started from a
# shell without agit on PATH must still record.

home=${AGIT_HOME:-${HOME:-/nonexistent}/.agit}
logdir=$home/log
log=$logdir/hook.log
conf=$home/setup.conf
nl='
'

# The git of the agit installed in $home: $home/current names the
# version, and the path names the version directory itself, as the
# PATH that install.sh writes does: on macOS, git finds its libexec
# directory from the path it was started by, without resolving
# symbolic links.
installed_git () {
	cur=$home/current
	if test -L "$cur"
	then
		v=$(readlink "$cur" 2>/dev/null) || return 1
		case "$v" in
		/*) cur=$v ;;
		*) cur=$home/$v ;;
		esac
	fi
	test -x "$cur/bin/git" && test -f "$cur/libexec/git-core/git-stamp" &&
	echo "$cur/bin/git"
}

if test -n "$AGIT_GIT"
then
	GIT=$AGIT_GIT
else
	GIT=$(installed_git) || GIT=git
fi

agent=$1
event=$2

# Cursor runs Claude Code plugins too, with CURSOR_PLUGIN_ROOT set,
# which Claude Code never sets; its own hooks record its edits.
if test "$agent" = claude && test -n "$CURSOR_PLUGIN_ROOT"
then
	exit 0
fi

# Append a line to the log, keeping it under about 1 MB.
log () {
	{
		mkdir -p "$logdir" || return
		if test -f "$log" &&
		   test "$(wc -c <"$log" 2>/dev/null || echo 0)" -gt 1048576
		then
			tail -c 262144 "$log" >"$log.$$" && mv -f "$log.$$" "$log"
		fi
		printf '%s %s %s: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
			"$agent" "$event" "$*" >>"$log"
	} 2>/dev/null
}

# Log, once per session, that the git found is not agit, and exit.
no_agit () {
	mark=$home/run/$agent/$sid.no-agit
	if ! test -f "$mark"
	then
		where=$(command -v "$GIT" 2>/dev/null) || where=$GIT
		log "$where is not agit; this session records nothing" \
			"(install agit, or set AGIT_HOME or AGIT_GIT)"
		mkdir -p "${mark%/*}" 2>/dev/null
		: >"$mark" 2>/dev/null
	fi
	exit 0
}

# Run git, logging its error output if it fails.  Exit if the git found
# is not agit.
stamp () {
	if err=$("$GIT" "$@" 2>&1 >/dev/null)
	then
		return 0
	fi
	case "$err" in
	*"'stamp' is not a git command"*)
		no_agit ;;
	esac
	log "git $*: $err"
	return 1
}

# Set $top and $prefix for the directory $1, or fail if it is not
# inside a worktree with provenance enabled.
worktree () {
	out=$("$GIT" -C "$1" rev-parse --show-toplevel --show-prefix 2>/dev/null) ||
	return 1
	top=${out%%"$nl"*}
	case "$out" in
	*"$nl"*) prefix=${out#*"$nl"} ;;
	*) prefix= ;;
	esac
	test -n "$top" || return 1
	test "$("$GIT" -C "$top" config --type=bool provenance.enabled 2>/dev/null)" != false
}

# Set $top and $rel for the file $1, which may not exist yet.
file_worktree () {
	f=$1
	case "$f" in
	/*) ;;
	*) f=$cwd/$f ;;
	esac
	dir=${f%/*}
	rest=${f##*/}
	test -n "$rest" || return 1
	while test -n "$dir" && ! test -d "$dir"
	do
		rest=${dir##*/}/$rest
		dir=${dir%/*}
	done
	worktree "${dir:-/}" || return 1
	rel=$prefix$rest
}

# Read the options of agit-setup.
read_conf () {
	opt_shell=true
	test -f "$conf" || return 0
	cfg=$("$GIT" config --file "$conf" --type=bool --get-regexp '^hook\.' 2>/dev/null) ||
	return 0
	while read -r key value
	do
		case "$key" in
		hook.shell) opt_shell=$value ;;
		esac
	done <<EOF
$cfg
EOF
}

# Succeed if the session has a begin in the journal of $top that no
# end has closed yet.  An end without it would attribute to the session
# every change since the last snapshot, or since HEAD once a commit
# has emptied the journal.
open_interval () {
	entries=$("$GIT" -C "$top" stamp list --session "$sid" 2>/dev/null) ||
	return 1
	last=
	while read -r kind _
	do
		case "$kind" in
		begin|end) last=$kind ;;
		esac
	done <<EOF
$entries
EOF
	test "$last" = begin
}

# Succeed if the shell command $cmd runs a git command that moves HEAD
# or rewrites the working tree.  Whole-tree stamps around it would
# attribute to the session the changes it checks out.
moves_head () {
	case "$cmd" in
	*git*) ;;
	*) return 1 ;;
	esac
	printf '%s\n' "$cmd" |
	grep -Eq '(^|[^[:alnum:]_./-])git([[:space:]]+-[Cc][[:space:]]+[^[:space:]]+)*[[:space:]]+(checkout|switch|reset|restore|stash|pull|merge|rebase|cherry-pick|revert|am|commit|worktree)([[:space:]]|$)'
}

# Claude Code: hook input fields to variables.
# shellcheck disable=SC2317 # called as input_$agent
input_claude () {
	tool=claude-code
	vars=$(printf '%s' "$input" | jq -r '
		def s: if type == "string" then . else "" end;
		[(.session_id | s), (.cwd | s),
		 (.tool_input.file_path // .tool_input.notebook_path | s),
		 (.tool_input.command | s), (.transcript_path | s),
		 (.model | if type == "object" then .id else . end | s)]
		| @sh' 2>/dev/null) || return 1
	eval "set -- $vars"
	sid=$1 cwd=$2 path=$3 cmd=$4 transcript=$5 model=$6
}

# Codex: hook input fields to variables
# (https://developers.openai.com/codex/hooks).  The patch of apply_patch
# and the command of Bash are both tool_input.command.  The transcript
# is not a stable interface, says the documentation: it is not read.
# shellcheck disable=SC2317 # called as input_$agent
input_codex () {
	tool=codex
	vars=$(printf '%s' "$input" | jq -r '
		def s: if type == "string" then . else "" end;
		[(.session_id | s), (.cwd | s), (.tool_input.command | s),
		 (.model | s)]
		| @sh' 2>/dev/null) || return 1
	eval "set -- $vars"
	sid=$1 cwd=$2 path='' cmd=$3 transcript='' model=$4
}

# Cursor: hook input fields to variables (https://cursor.com/docs/hooks).
# The session is the conversation.  Write and Delete name their file in
# tool_input.file_path; Shell runs in tool_input.cwd, which is empty
# for the first folder of the workspace.  sessionStart has no cwd: it
# is that folder too.  The model is "unknown" when Cursor cannot name
# it.  Cursor does not document its transcript.
# shellcheck disable=SC2317 # called as input_$agent
input_cursor () {
	tool=cursor
	vars=$(printf '%s' "$input" | jq -r '
		def s: if type == "string" then . else "" end;
		(.workspace_roots | if type == "array" then .[0] else "" end | s) as $w
		| ((.cwd | s) as $c | if $c == "" then (.tool_input.cwd | s) else $c end) as $c
		| [(.conversation_id // .session_id | s),
		   (if $c == "" then $w elif ($c | startswith("/")) or $w == "" then $c
		    else $w + "/" + $c end),
		   (.tool_input.file_path | s), (.tool_input.command | s),
		   (.model | s | if . == "unknown" then "" else . end)]
		| @sh' 2>/dev/null) || return 1
	eval "set -- $vars"
	sid=$1 cwd=$2 path=$3 cmd=$4 transcript='' model=$5
}

# Gemini CLI: hook input fields to variables
# (https://geminicli.com/docs/hooks/reference/).  write_file and replace
# name their file in tool_input.file_path; run_shell_command runs in
# tool_input.dir_path, relative to the directory of the session, if
# given.  The hook input has no model, and the transcript format is not
# documented.
# shellcheck disable=SC2317 # called as input_$agent
input_gemini () {
	tool=gemini-cli
	vars=$(printf '%s' "$input" | jq -r '
		def s: if type == "string" then . else "" end;
		(.cwd | s) as $cwd
		| (.tool_input.dir_path | s) as $d
		| [(.session_id | s),
		   (if $d == "" then $cwd elif ($d | startswith("/")) then $d
		    else $cwd + "/" + $d end),
		   (.tool_input.file_path | s), (.tool_input.command | s)]
		| @sh' 2>/dev/null) || return 1
	eval "set -- $vars"
	sid=$1 cwd=$2 path=$3 cmd=$4 transcript='' model=''
}

# The model of the last message of the agent in the transcript lines
# on stdin.
# shellcheck disable=SC2317 # called as model_$agent
model_claude () {
	jq -Rr 'fromjson? | select(type == "object" and .type == "assistant")
		| .message.model | strings | select(startswith("<") | not)' 2>/dev/null |
	tail -n 1
}

# shellcheck disable=SC2317 # called as context_$agent
context_claude () {
	jq -n --arg c "$1" \
		'{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $c}}' >&3
}

# Codex and Gemini CLI take the output of Claude Code.
# shellcheck disable=SC2317 # called as context_$agent
context_codex () {
	context_claude "$@"
}

# shellcheck disable=SC2317 # called as context_$agent
context_gemini () {
	context_claude "$@"
}

# shellcheck disable=SC2317 # called as context_$agent
context_cursor () {
	jq -n --arg c "$1" '{additional_context: $c}' >&3
}

session_start () {
	state=$home/run/$agent
	mkdir -p "$state" 2>/dev/null
	find "$state" -type f -mtime +7 -exec rm -f {} + 2>/dev/null
	if test -n "$model"
	then
		printf 'model=%s\n' "$model" >"$state/$sid" 2>/dev/null
	fi

	err=$("$GIT" stamp -h 2>&1)
	case "$err" in
	*"usage: git stamp"*) ;;
	*) no_agit ;;
	esac
	command -v "context_$agent" >/dev/null || exit 0

	# The context names the session itself rather than $AGIT_SESSION:
	# permission rules such as Bash(git *) do not match a command with
	# a variable in it.  Claude Code sources $CLAUDE_ENV_FILE before
	# each shell command: $home/env puts agit first on PATH there, so
	# that the commits of the agent are made by agit even when it was
	# started from a shell without it.
	if test -n "$CLAUDE_ENV_FILE"
	then
		{
			printf 'export AGIT_SESSION=%s\n' "$sid"
			if test -f "$home/env"
			then
				e=$(printf '%s' "$home/env" | sed "s/'/'\\\\''/g")
				printf "if test -f '%s'; then . '%s'; fi\n" "$e" "$e"
			fi
		} >>"$CLAUDE_ENV_FILE"
	fi

	worktree "$cwd" || exit 0
	"context_$agent" "This machine's git is agit, a Git that records, for \
each commit, which lines an AI wrote and why. Your edits to files are \
recorded automatically by hooks, including those made by shell commands.
Before each \`git commit\` that contains your changes, record why you \
made them: run \`git stamp reason --session $sid --summary -\` with a \
few sentences on stdin saying what changed and why. Do not pass \
\`--session\` to \`git commit\`: the recorded edits already link the \
commit to this session. Never run \`git stamp begin\`, \`git stamp end\` \
or \`git stamp edit\` yourself."
}

# The model of the session: the one in the hook input, else the one
# session-start remembered, else the last one in the transcript, which
# is then remembered.  Agents do not all tell it with each hook.
session_model () {
	state=$home/run/$agent/$sid
	if test -z "$model" && test -f "$state"
	then
		while IFS='=' read -r key value
		do
			test "$key" = model && model=$value
		done <"$state"
	fi
	if test -z "$model" && test -n "$transcript" && test -r "$transcript" &&
	   command -v "model_$agent" >/dev/null
	then
		model=$(tail -n 50 "$transcript" | "model_$agent")
		if test -n "$model"
		then
			mkdir -p "${state%/*}" 2>/dev/null
			printf 'model=%s\n' "$model" >"$state" 2>/dev/null
		fi
	fi
	case "$model" in
	*[[:space:]]*) model= ;;
	esac
}

# The paths that the edit changes, one per line: the file of the edit
# tool, or for Codex the files that the patch in $cmd adds, updates,
# deletes or moves to.  Codex reads each line of its patch with the
# white space around it trimmed, and resolves relative paths from the
# directory of the session; the grammar of apply_patch is in
# codex-rs/apply-patch/src/parser.rs (github.com/openai/codex).
edit_paths () {
	case "$agent" in
	codex)
		printf '%s\n' "$cmd" | sed -n -E \
			's/^[[:space:]]*\*\*\* (Add File|Update File|Delete File|Move to): (.*[^[:space:]])[[:space:]]*$/\2/p' ;;
	*)
		test -z "$path" || printf '%s\n' "$path" ;;
	esac
}

# Stamp $1 (begin or end) for the paths of the edit, with one stamp for
# all the paths in the same worktree: begin and end stamps for single
# paths in turn would take the index content of the other paths.
edit_stamps () {
	what=$1
	paths=$(edit_paths)
	us=$(printf '\037')
	list=
	while IFS= read -r p
	do
		if test -n "$p" && file_worktree "$p"
		then
			list=$list$top$us$rel$nl
		fi
	done <<EOF
$paths
EOF
	export GIT_LITERAL_PATHSPECS=1
	seen=$nl
	while IFS= read -r line
	do
		test -n "$line" || continue
		top=${line%%"$us"*}
		case "$seen" in
		*"$nl$top$nl"*) continue ;;
		esac
		seen=$seen$top$nl
		set --
		while IFS= read -r other
		do
			test "${other%%"$us"*}" = "$top" && set -- "$@" "${other#*"$us"}"
		done <<EOF
$list
EOF
		if test "$what" = begin
		then
			begin -- "$@"
		elif open_interval
		then
			stamp -C "$top" stamp end --session "$sid" -- "$@"
		fi
	done <<EOF
$list
EOF
}

begin () {
	session_model
	if test -n "$model"
	then
		stamp -C "$top" stamp begin --session "$sid" --tool "$tool" \
			--model "$model" "$@"
	else
		stamp -C "$top" stamp begin --session "$sid" --tool "$tool" "$@"
	fi
}

main () {
	if ! command -v jq >/dev/null 2>&1
	then
		if ! test -f "$logdir/jq-missing"
		then
			log "jq is not installed; agit-hook does nothing without it"
			: >"$logdir/jq-missing" 2>/dev/null
		fi
		exit 0
	fi
	case "$agent" in
	claude|codex|cursor|gemini) ;;
	*) log "unknown agent"; exit 0 ;;
	esac
	input=$(cat)
	"input_$agent" || { log "cannot read the hook input"; exit 0; }
	case "$sid" in
	''|*[!A-Za-z0-9._:-]*)
		log "invalid session id: $sid"; exit 0 ;;
	esac

	case "$event" in
	session-start)
		session_start ;;
	session-end)
		rm -f "$home/run/$agent/$sid" "$home/run/$agent/$sid".* 2>/dev/null ;;
	pre-edit)
		edit_stamps begin ;;
	post-edit)
		edit_stamps end ;;
	pre-shell)
		read_conf
		test "$opt_shell" = true || exit 0
		moves_head && exit 0
		worktree "$cwd" || exit 0
		begin ;;
	post-shell)
		read_conf
		test "$opt_shell" = true || exit 0
		moves_head && exit 0
		worktree "$cwd" || exit 0
		open_interval || exit 0
		stamp -C "$top" stamp end --session "$sid" ;;
	pre-commit)
		;;
	*)
		log "unknown event" ;;
	esac
} >/dev/null

# Whatever a hook prints may reach the agent: only the context of
# session-start is printed, to descriptor 3.
main 3>&1
exit 0
