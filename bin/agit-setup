#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Connect coding agents to agit: install the hooks that record their
# edits with git stamp, through each agent's own command line tool or,
# for the agents without one, in their hooks file.  Run with --help for
# the commands.

root=$(cd "$(dirname "$0")/.." && pwd -P)
home=${AGIT_HOME:-${HOME:?HOME is not set}/.agit}
conf=$home/setup.conf
log=$home/log/hook.log
GIT=${AGIT_GIT:-git}
plugin=agit@agit-setup
marketplace=agit-setup
agents="claude-code codex cursor gemini"
no_agit="is not agit; this session records nothing"

usage () {
	cat <<EOF
usage: agit-setup
   or: agit-setup add <agent> [--scope user|project|local] [--no-shell]
                              [--yes]
   or: agit-setup remove <agent>
   or: agit-setup status [<agent>]

Connect coding agents to agit, so that the lines they write, and why
they wrote them, are recorded in the provenance of your commits.

Without a command, ask which agents to connect and how.

Agents: claude-code (Claude Code), codex (Codex CLI), cursor (Cursor:
its editor and its agent command), gemini (Gemini CLI).

    --scope user         record in all your projects (default)
    --scope project      record in the project in the current directory,
                         for everyone who works on it with the agent
                         (Claude Code, Cursor, Gemini CLI)
    --scope local        record in the project in the current directory,
                         for you only (Claude Code)
    --no-shell           do not record the edits that the agent makes
                         through shell commands
    -y, --yes            do not ask for confirmation
EOF
}

say () {
	printf '%s\n' "$*"
}

warn () {
	printf '%s\n' "warning: $*" >&2
}

die () {
	printf '%s\n' "error: $*" >&2
	exit 1
}

# Succeed if this process can talk to a terminal.
have_tty () {
	(: </dev/tty) 2>/dev/null
}

# Ask the yes/no question $1 with the default $2 (y or n) on the
# terminal; succeed for yes.
ask () {
	if test "$2" = y
	then
		printf '%s [Y/n] ' "$1"
	else
		printf '%s [y/N] ' "$1"
	fi
	read -r answer </dev/tty || answer=
	case "$answer" in
	[Yy]*) return 0 ;;
	[Nn]*) return 1 ;;
	*) test "$2" = y ;;
	esac
}

# Succeed if the git $1 (default: git on PATH) is agit.
agit_ok () {
	"${1:-$GIT}" stamp -h 2>&1 | grep -q "usage: git stamp"
}

# Print the git that the hooks run, as bin/agit-hook finds it: $AGIT_GIT,
# else the agit installed in $home, else git on PATH.
hook_git () {
	if test -n "$AGIT_GIT"
	then
		echo "$AGIT_GIT"
		return
	fi
	cur=$home/current
	if test -L "$cur"
	then
		v=$(readlink "$cur" 2>/dev/null) || v=
		case "$v" in
		/*) cur=$v ;;
		*) cur=$home/$v ;;
		esac
	fi
	if test -x "$cur/bin/git" && test -f "$cur/libexec/git-core/git-stamp"
	then
		echo "$cur/bin/git"
	else
		command -v git 2>/dev/null || echo git
	fi
}

check_agit () {
	hg=$(hook_git)
	if agit_ok "$hg"
	then
		say "agit: $hg ($("$hg" version))"
	else
		warn "no agit found ($hg is not agit); the hooks do nothing" \
			"until agit is installed"
	fi
	if ! agit_ok
	then
		where=$(command -v "$GIT" 2>/dev/null) || where="no git"
		warn "git on PATH is $where, not agit: commits made from this" \
			"shell, and by agents started from it, are not recorded" \
			"(run . \"$home/env\" or open a new shell)"
	fi
}

need_jq () {
	command -v jq >/dev/null 2>&1 && return 0
	if command -v brew >/dev/null 2>&1
	then
		how="brew install jq"
	elif command -v apt-get >/dev/null 2>&1
	then
		how="sudo apt-get install jq"
	elif command -v dnf >/dev/null 2>&1
	then
		how="sudo dnf install jq"
	else
		how="see https://jqlang.org/download/"
	fi
	die "the hooks need jq, which was not found; install it ($how) and run agit-setup again"
}

# Print the value of the option $1 (true or false) with the default $2.
option () {
	v=$("$GIT" config --file "$conf" --type=bool "$1" 2>/dev/null) || v=$2
	echo "$v"
}

yes_no () {
	if test "$1" = true; then echo yes; else echo no; fi
}

# The name of the agent $1 for people.
agent_name () {
	case "$1" in
	claude-code) echo "Claude Code" ;;
	codex) echo "Codex" ;;
	cursor) echo "Cursor" ;;
	gemini) echo "Gemini CLI" ;;
	esac
}

# The scopes that the agent $1 supports.
agent_scopes () {
	case "$1" in
	claude-code) echo "user project local" ;;
	cursor|gemini) echo "user project" ;;
	*) echo "user" ;;
	esac
}

# The name of the functions of the agent $1: claude-code is claude.
fn () {
	case "$1" in
	claude-code) echo claude ;;
	*) echo "$1" ;;
	esac
}

scope_text () {
	case "$1" in
	user) echo "all your projects" ;;
	project) echo "the project in $dir, for everyone who works on it" ;;
	local) echo "the project in $dir, for you only" ;;
	esac
}

# The scope chosen for the agent $1.
scope_of () {
	eval "echo \"\${scope_$(fn "$1")}\""
}

summary () {
	say ""
	for a in $selected
	do
		say "  $(agent_name "$a"): $(scope_text "$(scope_of "$a")")"
	done
	say "  edits made by shell commands: $(yes_no "$shell")"
	say ""
}

write_options () {
	mkdir -p "$home" || die "cannot create $home"
	"$GIT" config --file "$conf" hook.shell "$shell" ||
	die "cannot write $conf"
}

# Record the installation $2 of the agent $1 in setup.conf.
record () {
	"$GIT" config --file "$conf" --fixed-value --unset-all "agent.$1.install" \
		"$2" 2>/dev/null
	"$GIT" config --file "$conf" --add "agent.$1.install" "$2" ||
	warn "cannot record the installation in $conf"
}

# Print the installations of the agent $1 recorded in setup.conf, else
# $2.
installs () {
	"$GIT" config --file "$conf" --get-all "agent.$1.install" 2>/dev/null ||
	echo "$2"
}

# --- Hooks files -----------------------------------------------------
#
# Our entries are those whose command runs agit-hook for the agent:
# sh "<path>/bin/agit-hook" <agent> <event>.  They are added after those
# of the user, and taken out exactly; the rest of the file is kept,
# though jq rewrites its layout.  A file that is not JSON is left alone,
# with an error.

# shellcheck disable=SC2016 # jq variables
jq_hooks='
def ours($a): type == "object" and (.command | type) == "string"
	and (.command | contains("agit-hook\" " + $a + " "));
def has_ours($a): ours($a)
	or (type == "object" and (.hooks | type) == "array" and any(.hooks[]; ours($a)));
def strip($a):
	if (.hooks | type) == "object" then
		.hooks |= with_entries(
			if (.value | type) == "array" and any(.value[]; has_ours($a)) then
				.value |= map(if ours($a) then empty
					elif has_ours($a) then
						(.hooks |= map(select(ours($a) | not)))
						| select(.hooks != [])
					else . end)
				| select(.value != [])
			else . end)
	else . end;
def mine($a):
	if (.hooks | type) == "object" then
		.hooks | with_entries(
			.value |= (if type == "array" then map(select(has_ours($a))) else [] end)
			| select(.value != []))
	else {} end;
'

# The path of agit-hook in the hook commands: from $HOME when it is
# under it, so that a project file works for everyone who installed
# agit-setup in the same place.  The agents run hook commands with a
# shell, which expands $HOME.
hook_path () {
	case "$root" in
	*[\"\\\$\`]*)
		warn "the path of agit-setup, $root, has a character that" \
			"cannot be in a hook command: \" \\ \$ or \`"
		return 1 ;;
	"$HOME"/*)
		echo "\$HOME/${root#"$HOME"/}/bin/agit-hook" ;;
	*)
		echo "$root/bin/agit-hook" ;;
	esac
}

# The hooks of the template $1, with the path of agit-hook in their
# commands in place of the string $2 (default: @AGIT_HOOK@).
render () {
	h=$(hook_path) || return 1
	jq -c --arg h "$h" --arg p "${2:-@AGIT_HOOK@}" '
	def cmd: if type == "object" and (.command | type) == "string"
		then .command |= (split($p) | join($h)) else . end;
	.hooks |= map_values(map(cmd | if (.hooks | type) == "array"
		then .hooks |= map(cmd) else . end))' "$1"
}

# edit_hooks <agent> <file> add <hooks>
# edit_hooks <agent> <file> remove
#
# Add our hooks for the agent, from the rendered template <hooks>, to
# the hooks file, or remove them.  A second add changes nothing.
edit_hooks () {
	a=$1 file=$2 what=$3 new=${4:-null}
	if test -f "$file"
	then
		if ! jq -e --argjson n "$new" '
			def ok($k): .hooks[$k] == null or (.hooks[$k] | type) == "array";
			type == "object"
			and (.hooks == null or (.hooks | type) == "object")
			and (. as $d | all(($n // {} | .hooks // {}) | keys[]; . as $k | $d | ok($k)))' \
			"$file" >/dev/null 2>&1
		then
			warn "$file is not JSON with hooks in the documented form;" \
				"fix it, or add the hooks in $root/agents by hand"
			return 1
		fi
		cur=$(cat "$file") || return 1
	elif test "$what" = remove
	then
		say "$file: no hooks file"
		return 0
	else
		cur=null
	fi
	# shellcheck disable=SC2016 # jq variables
	if test "$what" = add
	then
		filter='(if $cur == null then {} else $cur end) as $d
		| if ($d | mine($a)) == $n.hooks then $d
		  else $d | strip($a)
			| .hooks = (.hooks // {})
			| reduce ($n.hooks | to_entries[]) as $e (.;
				.hooks[$e.key] = ((.hooks[$e.key] // []) + $e.value))
		  end
		| if $n.version != null and .version == null
		  then {version: $n.version} + . else . end'
	else
		filter='$cur | strip($a)'
	fi
	out=$(printf '%s\n' "$cur" |
		jq --arg a "$a" --argjson n "$new" "$jq_hooks . as \$cur | $filter") ||
	return 1
	if test -f "$file" &&
	   test "$(jq -S -c . "$file")" = "$(printf '%s\n' "$out" | jq -S -c .)"
	then
		say "$file: unchanged"
		return 0
	fi
	if test -f "$file"
	then
		if ! test -e "$file.agit-backup"
		then
			cp -p "$file" "$file.agit-backup" ||
			{ warn "cannot back up $file"; return 1; }
			say "$file: backed up to $file.agit-backup"
		fi
	else
		mkdir -p "$(dirname "$file")" || return 1
	fi
	# Written in place, which keeps the mode of the file and a symbolic
	# link to it.
	printf '%s\n' "$out" >"$file" || { warn "cannot write $file"; return 1; }
	if test "$what" = add
	then
		say "$file: added the agit hooks"
	else
		say "$file: removed the agit hooks"
	fi
}

# Succeed if the hooks file $2 has our hooks for the agent $1, as in the
# rendered template $3.
has_hooks () {
	test -f "$2" &&
	jq -e --arg a "$1" --argjson n "$3" "$jq_hooks"' mine($a) == $n.hooks' \
		"$2" >/dev/null 2>&1
}

# Print the events for which the hooks file $2 has our hooks for the
# agent $1.
hooks_status () {
	if ! test -f "$2"
	then
		say "  $2: no hooks file"
		return
	fi
	jq -r --arg a "$1" --arg f "$2" "$jq_hooks"'
		(mine($a) | keys | join(", ")) as $e
		| if $e == "" then "  \($f): no agit hooks"
		  else "  \($f): agit hooks for \($e)" end' "$2" 2>/dev/null ||
	say "  $2: not valid JSON"
}

# --- Claude Code: the plugin of this repository ----------------------

# Run claude with its stdin from /dev/null.  Under curl | sh, install.sh
# runs agit-setup with its stdin from /dev/tty, and claude, which
# watches its stdin, fails on macOS with "EINVAL: invalid argument,
# kqueue" when that is /dev/tty rather than the terminal device itself.
run_claude () {
	claude "$@" </dev/null
}

need_claude () {
	command -v claude >/dev/null 2>&1 && return 0
	warn "claude is not on PATH; install Claude Code and run" \
		"agit-setup add claude-code again"
	return 1
}

# Set $found to where the agent is; fail if it cannot be connected.
# shellcheck disable=SC2317 # called as detect_$(fn agent)
detect_claude () {
	found=
	if command -v claude >/dev/null 2>&1
	then
		found=$(command -v claude)
		return 0
	fi
	test -d "$HOME/.claude" && found="$HOME/.claude, but claude is not on PATH"
	return 1
}

# shellcheck disable=SC2317 # called as add_$(fn agent)
add_claude () {
	need_claude || return 1
	say "adding the marketplace $marketplace from $root"
	run_claude plugin marketplace add "$root" || return 1
	say "installing $plugin ($scope scope)"
	(cd "$dir" && run_claude plugin install "$plugin" --scope "$scope" -y) || return 1
	case "$scope" in
	user) record claude-code user ;;
	*) record claude-code "$scope:$dir" ;;
	esac
}

# shellcheck disable=SC2317 # called as remove_$(fn agent)
remove_claude () {
	need_claude || return 1
	entries=$(installs claude-code user)
	status=0
	while IFS= read -r entry
	do
		case "$entry" in
		user)
			say "uninstalling $plugin (user scope)"
			run_claude plugin uninstall "$plugin" --scope user -y || status=1 ;;
		project:*|local:*)
			s=${entry%%:*}
			d=${entry#*:}
			if test -d "$d"
			then
				say "uninstalling $plugin ($s scope, $d)"
				(cd "$d" && run_claude plugin uninstall "$plugin" --scope "$s" -y) ||
				status=1
			else
				warn "$d no longer exists; skipping its $s scope"
			fi ;;
		esac
	done <<EOF
$entries
EOF
	say "removing the marketplace $marketplace"
	run_claude plugin marketplace remove "$marketplace" || status=1
	"$GIT" config --file "$conf" --unset-all agent.claude-code.install 2>/dev/null
	return $status
}

# shellcheck disable=SC2317 # called as check_$(fn agent)
check_claude () {
	if (cd "$dir" && run_claude plugin list --json 2>/dev/null) |
		jq -e --arg p "$plugin" 'any(.[]; .id == $p and .enabled)' >/dev/null 2>&1
	then
		say "done: Claude Code records its edits with agit from its next session"
	else
		warn "claude plugin list does not show $plugin as enabled"
		return 1
	fi
}

# shellcheck disable=SC2317 # called as status_$(fn agent)
status_claude () {
	if ! command -v claude >/dev/null 2>&1
	then
		say "Claude Code:  not found"
		return
	fi
	say "Claude Code:  $(command -v claude) ($(run_claude --version 2>/dev/null))"
	if command -v jq >/dev/null 2>&1
	then
		run_claude plugin list --json 2>/dev/null |
		jq -r --arg p "$plugin" '.[] | select(.id == $p) |
			"  \(.id) \(.version), \(.scope) scope, " +
			(if .enabled then "enabled" else "disabled" end)'
	fi
	"$GIT" config --file "$conf" --get-all agent.claude-code.install 2>/dev/null |
	sed 's/^/  installed by agit-setup: /'
}

# --- Codex CLI: $CODEX_HOME/hooks.json -------------------------------
#
# https://developers.openai.com/codex/hooks.  Codex installs plugins
# from a local marketplace too, but it copies them without their
# symbolic links, and asks again to trust the hooks of a plugin
# whenever any file of the plugin changes.  The hooks file names the
# agit-hook of this directory instead: its contents stay the same
# across upgrades of agit-setup, so the user trusts the hooks once.

codex_home () {
	echo "${CODEX_HOME:-$HOME/.codex}"
}

# shellcheck disable=SC2317 # called as detect_$(fn agent)
detect_codex () {
	found=
	if command -v codex >/dev/null 2>&1
	then
		found=$(command -v codex)
	elif test -d "$(codex_home)"
	then
		found=$(codex_home)
	else
		return 1
	fi
}

# shellcheck disable=SC2317 # called as add_$(fn agent)
add_codex () {
	new=$(render "$root/agents/codex/hooks.json") || return 1
	edit_hooks codex "$(codex_home)/hooks.json" add "$new" || return 1
	record codex "user:$(codex_home)/hooks.json"
}

# shellcheck disable=SC2317 # called as remove_$(fn agent)
remove_codex () {
	status=0
	while IFS= read -r entry
	do
		edit_hooks codex "${entry#*:}" remove || status=1
	done <<EOF
$(installs codex "user:$(codex_home)/hooks.json")
EOF
	"$GIT" config --file "$conf" --unset-all agent.codex.install 2>/dev/null
	return $status
}

# shellcheck disable=SC2317 # called as check_$(fn agent)
check_codex () {
	if has_hooks codex "$(codex_home)/hooks.json" "$(render "$root/agents/codex/hooks.json")"
	then
		say "done: Codex records its edits with agit once you trust its"
		say "hooks: start codex, run /hooks, and trust the agit hooks.  Codex"
		say "asks again only if they change."
	else
		warn "$(codex_home)/hooks.json does not have the agit hooks"
		return 1
	fi
}

# shellcheck disable=SC2317 # called as status_$(fn agent)
status_codex () {
	detect_codex
	say "Codex:        ${found:-not found}"
	hooks_status codex "$(codex_home)/hooks.json"
}

# --- Cursor: ~/.cursor/hooks.json, or .cursor/hooks.json of a project -
#
# https://cursor.com/docs/hooks, for Cursor 3.  The agent writes and
# deletes files with its Write and Delete tools, and runs commands with
# Shell: preToolUse and postToolUse, or postToolUseFailure, come before
# and after each.  The env that sessionStart may return reaches only
# the later hooks of the session, not the shell commands of the agent,
# so agit-hook returns none.  The tool hooks print nothing, which
# leaves the decision on a tool to Cursor and to the other hooks.

cursor_file () {
	case "$1" in
	project) echo "$dir/.cursor/hooks.json" ;;
	*) echo "$HOME/.cursor/hooks.json" ;;
	esac
}

# shellcheck disable=SC2317 # called as detect_$(fn agent)
detect_cursor () {
	found=
	for c in cursor cursor-agent agent
	do
		if command -v "$c" >/dev/null 2>&1
		then
			found=$(command -v "$c")
			return 0
		fi
	done
	test -d "$HOME/.cursor" && found=$HOME/.cursor
}

# shellcheck disable=SC2317 # called as add_$(fn agent)
add_cursor () {
	new=$(render "$root/agents/cursor/hooks.json") || return 1
	edit_hooks cursor "$(cursor_file "$scope")" add "$new" || return 1
	record cursor "$scope:$(cursor_file "$scope")"
}

# shellcheck disable=SC2317 # called as remove_$(fn agent)
remove_cursor () {
	status=0
	while IFS= read -r entry
	do
		edit_hooks cursor "${entry#*:}" remove || status=1
	done <<EOF
$(installs cursor "user:$(cursor_file user)")
EOF
	"$GIT" config --file "$conf" --unset-all agent.cursor.install 2>/dev/null
	return $status
}

# shellcheck disable=SC2317 # called as check_$(fn agent)
check_cursor () {
	if has_hooks cursor "$(cursor_file "$scope")" "$(render "$root/agents/cursor/hooks.json")"
	then
		say "done: Cursor records the edits of its agent with agit; restart"
		say "Cursor, and the cursor agent command, if they are running."
	else
		warn "$(cursor_file "$scope") does not have the agit hooks"
		return 1
	fi
}

# shellcheck disable=SC2317 # called as status_$(fn agent)
status_cursor () {
	detect_cursor
	say "Cursor:       ${found:-not found}"
	files=$(installs cursor "user:$(cursor_file user)")
	while IFS= read -r entry
	do
		hooks_status cursor "${entry#*:}"
	done <<EOF
$files
EOF
}

# --- Gemini CLI: the extension of this repository --------------------
#
# https://geminicli.com/docs/extensions/reference/.  For all projects,
# extensions/gemini is linked with gemini extensions link, which keeps
# it in sync with upgrades of this directory; for one project, its hooks
# go in the .gemini/settings.json of the project.

gemini_ext=agit

# Run gemini with its stdin from /dev/null, and the workspace trusted
# for this command only: extensions link asks to trust the current
# directory otherwise.
run_gemini () {
	GEMINI_CLI_TRUST_WORKSPACE=true gemini "$@" </dev/null
}

need_gemini () {
	command -v gemini >/dev/null 2>&1 && return 0
	warn "gemini is not on PATH; install Gemini CLI and run" \
		"agit-setup add gemini again"
	return 1
}

# Print the install type and source of the extension $gemini_ext, if
# it is installed.  Gemini CLI prints the list on its standard error.
gemini_linked () {
	(cd "$dir" && run_gemini extensions list --output-format json 2>&1) |
	sed -n '/^\[/,/^\]$/p' |
	jq -r --arg n "$gemini_ext" '.[]? | select(.name == $n)
		| "\(.installMetadata.type // "") \(.installMetadata.source // "")"' 2>/dev/null
}

gemini_project_file () {
	echo "$dir/.gemini/settings.json"
}

# The hooks of the extension, for the settings of a project.
gemini_hooks () {
	# shellcheck disable=SC2016 # the variable of Gemini CLI
	render "$root/extensions/gemini/hooks/hooks.json" \
		'${extensionPath}/../../bin/agit-hook'
}

# shellcheck disable=SC2317 # called as detect_$(fn agent)
detect_gemini () {
	found=
	if command -v gemini >/dev/null 2>&1
	then
		found=$(command -v gemini)
		return 0
	fi
	test -d "$HOME/.gemini" && found="$HOME/.gemini, but gemini is not on PATH"
	return 1
}

# shellcheck disable=SC2317 # called as add_$(fn agent)
add_gemini () {
	if test "$scope" = project
	then
		new=$(gemini_hooks) || return 1
		edit_hooks gemini "$(gemini_project_file)" add "$new" || return 1
		record gemini "project:$(gemini_project_file)"
		return
	fi
	need_gemini || return 1
	linked=$(gemini_linked)
	case "$linked" in
	"link $root/extensions/gemini")
		say "the Gemini CLI extension $gemini_ext is linked already" ;;
	'')
		say "linking the Gemini CLI extension $gemini_ext from $root/extensions/gemini"
		(cd "$dir" && run_gemini extensions link "$root/extensions/gemini" --consent) ||
		return 1 ;;
	*)
		warn "another Gemini CLI extension named $gemini_ext is installed" \
			"($linked); remove it with: gemini extensions uninstall $gemini_ext"
		return 1 ;;
	esac
	record gemini user
}

# shellcheck disable=SC2317 # called as remove_$(fn agent)
remove_gemini () {
	status=0
	while IFS= read -r entry
	do
		case "$entry" in
		user)
			need_gemini || { status=1; continue; }
			case "$(gemini_linked)" in
			"link $root/extensions/gemini")
				say "uninstalling the Gemini CLI extension $gemini_ext"
				(cd "$dir" && run_gemini extensions uninstall "$gemini_ext") ||
				status=1 ;;
			'')
				say "the Gemini CLI extension $gemini_ext is not installed" ;;
			*)
				warn "the Gemini CLI extension $gemini_ext was not linked by" \
					"agit-setup; leaving it" ;;
			esac ;;
		project:*)
			edit_hooks gemini "${entry#*:}" remove || status=1 ;;
		esac
	done <<EOF
$(installs gemini user)
EOF
	"$GIT" config --file "$conf" --unset-all agent.gemini.install 2>/dev/null
	return $status
}

# shellcheck disable=SC2317 # called as check_$(fn agent)
check_gemini () {
	if test "$scope" = project
	then
		if has_hooks gemini "$(gemini_project_file)" "$(gemini_hooks)"
		then
			say "done: Gemini CLI records its edits in $dir with agit from its"
			say "next session, once the folder is trusted."
			return 0
		fi
		warn "$(gemini_project_file) does not have the agit hooks"
		return 1
	fi
	if test "$(gemini_linked)" = "link $root/extensions/gemini"
	then
		say "done: Gemini CLI records its edits with agit from its next session"
	else
		warn "gemini extensions list does not show $gemini_ext linked from" \
			"$root/extensions/gemini"
		return 1
	fi
}

# shellcheck disable=SC2317 # called as status_$(fn agent)
status_gemini () {
	if ! detect_gemini
	then
		say "Gemini CLI:   ${found:-not found}"
		return
	fi
	say "Gemini CLI:   $found ($(run_gemini --version 2>/dev/null))"
	linked=$(gemini_linked)
	if test -n "$linked"
	then
		say "  extension $gemini_ext: $linked"
	else
		say "  extension $gemini_ext: not installed"
	fi
	installs gemini '' | while IFS= read -r entry
	do
		case "$entry" in
		project:*) hooks_status gemini "${entry#*:}" ;;
		esac
	done
}

# --- Commands --------------------------------------------------------

# Die unless $1 names an agent.
check_agent () {
	case " $agents " in
	*" $1 "*) ;;
	*) die "unknown agent: $1 (agents: $agents)" ;;
	esac
}

cmd_add () {
	agent=
	scope=user
	shell=true
	yes=
	while test $# -gt 0
	do
		case "$1" in
		--scope)
			test $# -gt 1 || die "--scope needs a value"
			scope=$2; shift ;;
		--scope=*)
			scope=${1#*=} ;;
		--no-shell)
			shell=false ;;
		-y|--yes)
			yes=1 ;;
		-*)
			die "unknown option: $1" ;;
		*)
			test -z "$agent" || die "one agent at a time"
			agent=$1 ;;
		esac
		shift
	done
	test -n "$agent" || die "name the agent to add: $agents"
	check_agent "$agent"
	case "$scope" in
	user|project|local) ;;
	*) die "--scope must be user, project or local" ;;
	esac
	case " $(agent_scopes "$agent") " in
	*" $scope "*) ;;
	*) die "$(agent_name "$agent") supports --scope $(agent_scopes "$agent" | sed 's/ /, /g')" ;;
	esac
	dir=$(pwd -P)
	need_jq
	case "$agent:$scope" in
	claude-code:*) need_claude || exit 1 ;;
	gemini:user) need_gemini || exit 1 ;;
	esac
	check_agit
	selected=$agent
	eval "scope_$(fn "$agent")=\$scope"
	summary
	if test -z "$yes" && have_tty && ! ask "Apply?" y
	then
		say "nothing changed"
		return 0
	fi
	apply || exit 1
}

# Connect the agents in $selected, each with its scope.
apply () {
	write_options
	failed=
	for a in $selected
	do
		f=$(fn "$a")
		scope=$(scope_of "$a")
		if "add_$f"
		then
			"check_$f" || failed=1
		else
			warn "could not connect $(agent_name "$a")"
			failed=1
		fi
	done
	test -z "$failed"
}

cmd_remove () {
	test $# = 1 || die "usage: agit-setup remove <agent>"
	check_agent "$1"
	dir=$(pwd -P)
	"remove_$(fn "$1")"
}

cmd_status () {
	only=$1
	test -z "$only" || check_agent "$only"
	dir=$(pwd -P)
	where=$(command -v "$GIT" 2>/dev/null) || where=
	if test -z "$where"
	then
		say "agit:         git not found on PATH"
	elif agit_ok
	then
		say "agit:         $where ($("$GIT" version))"
	else
		say "agit:         not on PATH; $where is $("$GIT" version)"
	fi
	if command -v jq >/dev/null 2>&1
	then
		say "jq:           $(command -v jq) ($(jq --version 2>&1))"
		v=$(jq -r .version "$root/plugins/claude-code/.claude-plugin/plugin.json" 2>/dev/null)
	else
		say "jq:           not found; the hooks do nothing without it"
		v=
	fi
	say "agit-setup:   $root${v:+ (plugin $v)}"
	say "hooks run:    $(hook_git)"
	say "options:      edits made by shell commands: $(yes_no "$(option hook.shell true)")"
	for a in $agents
	do
		test -z "$only" || test "$a" = "$only" || continue
		"status_$(fn "$a")"
	done
	# The hooks of Claude Code put agit first on the PATH of its shell
	# commands; the other agents commit with the git on the PATH they
	# were started with.
	if ! agit_ok
	then
		for a in $agents
		do
			test "$a" != claude-code || continue
			"$GIT" config --file "$conf" --get-all "agent.$a.install" >/dev/null 2>&1 ||
			continue
			warn "git on PATH is not agit here: the commits that $(agent_name "$a")" \
				"makes are recorded only if it starts from a shell with agit" \
				"on PATH (. \"$home/env\")"
		done
	fi
	if test -s "$log" && grep -q "$no_agit" "$log"
	then
		warn "the hooks found no agit in some sessions; the last time:"
		grep "$no_agit" "$log" | tail -n 1 | sed 's/^/  /' >&2
	fi
	if test -s "$log"
	then
		say "hook log:     $log, last errors:"
		tail -n 5 "$log" | sed 's/^/  /'
	else
		say "hook log:     no errors"
	fi
}

interactive () {
	have_tty || { usage >&2; exit 1; }
	dir=$(pwd -P)
	say "agit-setup: connect coding agents to agit"
	say ""
	check_agit
	need_jq

	# The agents found are selected at first; the others are listed
	# and cannot be.
	picks=
	n=0
	for a in $agents
	do
		n=$((n + 1))
		if "detect_$(fn "$a")"
		then
			eval "ok_$n=1"
			picks="$picks $a"
		else
			eval "ok_$n="
		fi
		eval "found_$n=\$found"
	done
	while :
	do
		say ""
		say "Coding agents:"
		n=0
		f='' ok=''
		for a in $agents
		do
			n=$((n + 1))
			eval "f=\$found_$n ok=\$ok_$n"
			case " $picks " in
			*" $a "*) mark=x ;;
			*) mark=' ' ;;
			esac
			if test -n "$ok"
			then
				say "  $n) [$mark] $(agent_name "$a") ($f)"
			else
				say "     [-] $(agent_name "$a"): ${f:-not found}"
			fi
		done
		printf 'Type a number to select or deselect it, Enter to continue: '
		read -r answer </dev/tty || answer=
		test -n "$answer" || break
		n=0
		hit=
		for a in $agents
		do
			n=$((n + 1))
			eval "ok=\$ok_$n"
			if test "$answer" != "$n" || test -z "$ok"
			then
				continue
			fi
			hit=1
			case " $picks " in
			*" $a "*) picks=$(echo " $picks " | sed "s/ $a / /") ;;
			*) picks="$picks $a" ;;
			esac
		done
		test -n "$hit" || say "no agent $answer"
	done
	selected=
	for a in $agents
	do
		case " $picks " in
		*" $a "*) selected="$selected $a" ;;
		esac
	done
	if test -z "$selected"
	then
		say "no agent selected; nothing changed"
		return 0
	fi

	say ""
	shell=true
	ask "Record the edits the agents make through shell commands?" y || shell=false

	for a in $selected
	do
		scopes=$(agent_scopes "$a")
		s=user
		if test "$scopes" != user
		then
			say ""
			say "Where should $(agent_name "$a") record its edits?"
			say "  1) all your projects (default)"
			say "  2) the project in $dir, for everyone who works on it"
			case "$scopes" in
			*local*)
				say "  3) the project in $dir, for you only"
				printf 'Choose 1, 2 or 3: ' ;;
			*)
				printf 'Choose 1 or 2: ' ;;
			esac
			read -r answer </dev/tty || answer=
			case "$answer:$scopes" in
			2:*) s=project ;;
			3:*local*) s=local ;;
			esac
		fi
		eval "scope_$(fn "$a")=\$s"
	done

	summary
	if ! ask "Apply?" y
	then
		say "nothing changed"
		return 0
	fi
	apply
}

case "$1" in
-h|--help|help)
	usage ;;
'')
	interactive ;;
add)
	shift; cmd_add "$@" ;;
remove)
	shift; cmd_remove "$@" ;;
status)
	shift
	test $# -le 1 || die "usage: agit-setup status [<agent>]"
	cmd_status "$@" ;;
*)
	printf '%s\n' "error: unknown command: $1" >&2
	usage >&2; exit 1 ;;
esac
